# CourtVision Environment Configuration Example
# Copy this file to .env or export these variables in your shell

# --- Decision Layer (TypeSafe Jev) ---
# API key for the TypeSafe Jev decision service (evaluates play type, stakes, coach card ranking, Claude line guard).
# If unset, CourtVision automatically uses deterministic local rule fallbacks.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# --- Live Narration (Claude) ---
# Anthropic API key used by the live narration director for dead-ball colour lines and commentary.
# If unset, narration operates in deterministic template-only mode.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Server Security ---
# Bearer auth token required when running `courtvision serve` on public/network interfaces.
# If unset on non-loopback hosts, serve refuses connection unless explicitly run with --insecure-no-auth.
COURTVISION_TOKEN=your_secure_bearer_token_here
